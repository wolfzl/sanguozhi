{
  "name": "sanguozhi-card-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run validate && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && node --test tests/*.test.mjs",
    "validate": "node scripts/validate-content.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "extract": "python3 scripts/extract_epub.py"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "opencc-js": "^1.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "playwright": "^1.56.0"
  }
}
