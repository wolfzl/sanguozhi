---
import '../styles/global.css';
interface Props { title?: string; description?: string; active?: string }
const {title='读懂人物，看见历史',description='从三十四位人物、三十八个历史事件进入《三国志》，沿着原文与裴注，读懂历史的来龙去脉。',active=''}=Astro.props;
const pageTitle=`${title} · 三国志`;
const canonical=Astro.site ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const image=Astro.site ? new URL('/share-card.png',Astro.site).href : '/share-card.png';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content="#f5f1e8"/><meta name="description" content={description}/>
<title>{pageTitle}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
{canonical && <link rel="canonical" href={canonical}/>}
<meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/>
<meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/>
<meta property="og:image" content={image}/>{canonical && <meta property="og:url" content={canonical}/>}
<meta name="twitter:card" content="summary_large_image"/>
</head>
<body>
<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header"><div class="shell header-inner">
<a href="/" class="brand" aria-label="三国志首页"><span class="brand-seal">三</span><span class="brand-name">三国志<small>人物 · 事件 · 原文</small></span></a>
<nav aria-label="主导航">
{[['/people/','人物','people'],['/events/','事件','events'],['/read/','读原文','read']].map(([url,label,key])=><a href={url} aria-current={active===key?'page':undefined}>{label}</a>)}
</nav><a class="edition-link" href="/about/">关于本书 <span aria-hidden="true">↗</span></a>
</div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="shell footer-inner"><a class="footer-brand" href="/">三国志<span>从一人一事，进入一部史书。</span></a><div class="footer-note"><p>陈寿撰 · 裴松之注 · 维基文库网络文本</p><p><a href="/about/">版本与来源</a><span> / </span><a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a></p></div></div></footer>
<div class="toast" data-toast role="status" aria-live="polite"></div>
<script>import '../lib/browser';</script>
</body></html>
