---
import Sources from './Sources.astro';
import Citations from './Citations.astro';
import Share from './Share.astro';
import EventRow from './EventRow.astro';
import PersonNarrative from './PersonNarrative.astro';
import { personById, eventById, referencesFor, volumes, volumeTitle } from '../lib/catalog';
import { DEFAULT_ATLAS_BASE, phaseUrl, routeUrl, phaseNumeral } from '../lib/atlas.mjs';
import type { Person, DossierRecord } from '../lib/catalog';
interface Props { person: Person }
const { person: p } = Astro.props;
const d = p.dossier!;
const refs = referencesFor(p);
const sections = [
  {id:'civil-achievements',title:'文治功绩',eyebrow:'治理与谋划',records:d.civil,note:d.civilNote},
  {id:'military-achievements',title:'武功功绩',eyebrow:'征战中的贡献',records:d.military,note:d.militaryNote},
  {id:'setbacks',title:d.expanded?'失误、挫折与争议':'失误与挫折',eyebrow:'看见经历中的得失',records:d.setbacks,note:d.setbacksNote},
];
const atlasBase = import.meta.env.PUBLIC_ATLAS_BASE || DEFAULT_ATLAS_BASE;
const trajectory = d.trajectory;
const phases = trajectory?.phases ?? [];
const hasTrajectory = phases.length > 0;
const hasUnmappedPhases = phases.some(ph => ph.unmappedReason);
const phaseStart = new Map(phases.map((ph,i)=>[ph.careers[0],{ph,i}]));
const careerTitle = new Map(p.milestones.map(m=>[m.id,m]));
const stopLabel = (ph: {atlasStops?: number[]}) => ph.atlasStops?.length ? `地图第 ${ph.atlasStops.map(n=>n+1).join('、')} 站` : '地图未单列此期';
const recordGroups = (rows: DossierRecord[]) => Array.from(new Set(rows.map(r=>r.group ?? ''))).map(title=>({title,rows:rows.filter(r=>(r.group ?? '')===title)}));
const navigation = [
  ['life','人物介绍'],['milestones','生平履历'],...(hasTrajectory ? [['trajectory','行迹地图']] : []),
  ...sections.map(s=>[s.id,s.title]),...(d.scholarship?.length ? [['scholarship','治学与个人侧面']] : []),...(d.assessment?.length ? [['assessment','史家评价']] : []),['relations','人物关系'],...((d.expanded?d.readingNotes?.length:p.note)?[['reading-note',d.expanded?'阅读提示与史料辨析':'阅读提示']]:[]),
  ['related-events','相关事件'],['sources','原文依据'],
];
---
<div class:list={["shell detail-page person-dossier", {"expanded-dossier":d.expanded}]}>
  <a class="back-link" href="/people/">← 人物列表</a>
  <header class="detail-heading">
    <div>
      <div class="eyebrow">人物 / {p.faction}<span class="reading-tier">{d.tier}</span></div>
      <h1>{p.name}<span>{p.courtesy==='本书未详'?'字号未详':`字 ${p.courtesy}`}</span></h1>
      <p class="detail-lead">{p.lead}</p>
    </div>
    <Share />
  </header>
  <div class="article-layout">
    <aside class="detail-sidebar">
      <div class="profile-seal" aria-hidden="true">{p.name.slice(0,1)}</div>
      <span class="section-eyebrow">人物小档案</span>
      <dl>
        {p.lifespan && <>
          <dt>生卒年</dt>
          <dd>{p.lifespan.text}<details class="lifespan-evidence"><summary>年代依据</summary><p>{p.lifespan.note}<a href={p.lifespan.sourceUrl}>{p.lifespan.sourceTitle} ↗</a></p></details></dd>
        </>}
        <dt>籍贯</dt><dd>{d.hometown}</dd>
        <dt>主要身份</dt><dd>{p.role}</dd>
        <dt>最高官职</dt><dd>{d.highestOffice}</dd>
        <dt>最高爵位</dt><dd>{d.highestTitle}</dd>
        <dt>谥号</dt><dd>{d.posthumous}</dd>
        <dt>常见称谓</dt><dd>{p.aliases.map(a=>p.id==='zhangfei'&&a==='桓侯'?'张桓侯':a).join('、')||'暂无其他称谓'}</dd>
        <dt>代表事迹</dt><dd>{d.deeds.join('、')}</dd>
      </dl>
      <div class="profile-evidence">档案依据<Citations refs={d.refs} all={refs}/></div>
      <nav aria-label="本页目录">
        {navigation.map(([id,title],index)=><a href={`#${id}`}>{title}<span>{String(index+1).padStart(2,'0')}</span></a>)}
      </nav>
    </aside>
    <article class="article-body">
      <section id="life" class="article-section">
        <div class="section-eyebrow">认识这个人</div><h2>人物介绍</h2>
        {d.sourceScope && <p class="evidence-note source-scope">{d.sourceScope}</p>}
        {p.paragraphs.map(paragraph=><div class="narrative-part">{paragraph.title&&<h3>{paragraph.title}</h3>}<p><PersonNarrative paragraph={paragraph}/><Citations refs={paragraph.refs} all={refs}/></p></div>)}
      </section>
      <section id="milestones" class="article-section">
        <div class="section-eyebrow">沿着经历看变化</div><h2>生平履历</h2>
        <table class="dossier-table career-table">
          <caption class="sr-only">{p.name}的重要经历与官职、爵位变化</caption>
          <thead><tr><th scope="col">时间</th><th scope="col">重要经历</th><th scope="col">官职、爵位变化</th></tr></thead>
          <tbody>{p.milestones.map(m=><Fragment>{m.id&&phaseStart.has(m.id)&&(()=>{const {ph,i}=phaseStart.get(m.id)!;return <tr id={`phase-${ph.id}`} class="phase-row"><th colspan="3" scope="rowgroup"><span class="phase-no">{phaseNumeral(i)}</span><strong>{ph.title}</strong><span class="phase-when">{ph.when}</span>{phaseUrl(atlasBase,trajectory!,ph)?<a href={phaseUrl(atlasBase,trajectory!,ph)} target="_blank" rel="noopener">在地图上看 ↗</a>:<span class="phase-unmapped">{trajectory!.atlasPerson ? "本期未标点" : "地点未详"}</span>}</th></tr>;})()}<tr id={m.id?`career-${m.id}`:undefined}>
            <th scope="row" data-label="时间"><span class="milestone-date">{m.when}</span></th>
            <td data-label="重要经历">{d.expanded&&<strong>{m.title}</strong>}<p>{m.text}<Citations refs={m.refs} all={refs}/></p>{m.eventIds && m.eventIds.length>0&&<div class="record-events">{m.eventIds.map(id=><a href={`/events/${id}/`}>{eventById(id).title} ↗</a>)}</div>}</td>
            <td data-label="官职、爵位变化" class:list={{'office-change':m.office!=='—','no-change':m.office==='—'}}>{m.office}</td>
          </tr></Fragment>)}</tbody>
        </table>
      </section>
      {hasTrajectory&&<section id="trajectory" class="article-section trajectory">
        <div class="section-eyebrow">把经历放回地图</div><h2>行迹地图</h2>
        <p class="evidence-note">{p.name}一生分为 {phases.length} 个时期。{trajectory!.atlasPerson?<Fragment>地图直接使用<a href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">江山时序</a>的{p.name}路线，与在江山时序中搜索{p.name}看到的相同；地图上的说明文字出自江山时序，本站内容以下表和生平履历为准。</Fragment>:<Fragment>{hasUnmappedPhases?"地图标示本书明确记载的地点，地点未详的时期见下表。地图由":"每个时期取一个代表地点，由"}<a href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">江山时序</a>{hasUnmappedPhases?"提供；":"连成路线；"}站名用的是它的地名。</Fragment>}疆域为示意性近似。连线表示已知地点的先后关系，不是古代道路复原；选中时期的到达路段为实线，其余为虚线，虚实不表示史料可信度。未载地点、未实施的计划与身后追谥不补造足迹。</p>
        <div class="atlas-frame"><iframe src={routeUrl(atlasBase,trajectory!,{embed:true})} title={`${p.name}行迹地图`} loading="lazy"></iframe></div>
        <a class="atlas-open" href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">在江山时序中打开 ↗</a>
        <ol class="trajectory-list">{phases.map((ph,i)=><li>
          <span class="stop-index">{phaseNumeral(i)}</span>
          <div>{phaseUrl(atlasBase,trajectory!,ph)?<a href={phaseUrl(atlasBase,trajectory!,ph)} target="_blank" rel="noopener"><strong>{ph.title}</strong><small class="phase-meta">{ph.when} · {trajectory!.atlasPerson?stopLabel(ph):`${ph.place!.name}${ph.place!.approx?'（地图近似）':''}`} ↗</small></a>:<Fragment><strong>{ph.title}</strong><small class="phase-meta">{ph.when} · {trajectory!.atlasPerson ? "本期未标点" : "地点未详"}</small></Fragment>}
          {ph.unmappedReason&&<p>{ph.unmappedReason}</p>}
          <p>{ph.careers.map(id=>careerTitle.get(id)).map(row=>row&&<a class="stop-row" href={`#career-${row.id}`}>{row.title}</a>)}</p></div>
        </li>)}</ol>
      </section>}
      {sections.map(section=><section id={section.id} class="article-section">
        <div class="section-eyebrow">{section.eyebrow}</div><h2>{section.title}</h2>
        {section.records.length>0?recordGroups(section.records).map(group=><Fragment>{group.title&&<h3 class="group-title">{group.title}</h3>}<table class="dossier-table achievement-table">
          <caption class="sr-only">{p.name}的{section.title}</caption>
          <thead><tr><th scope="col">年份</th><th scope="col">{section.id==='setbacks'?'事件':'功绩'}</th><th scope="col">{section.id==='setbacks'?'性质':'类型'}</th><th scope="col">{section.id==='setbacks'?'经过与后果':'具体表现与影响'}</th></tr></thead>
          <tbody>{group.rows.map(record=><tr>
            <th scope="row" data-label="年份">{record.when}</th>
            <td data-label={section.id==='setbacks'?'事件':'功绩'}><strong>{record.title}</strong></td>
            <td data-label={section.id==='setbacks'?'性质':'类型'}><span class="record-category">{record.category}</span></td>
            <td data-label={section.id==='setbacks'?'经过与后果':'具体表现与影响'}><p>{record.text}<Citations refs={record.refs} all={refs}/></p>{record.eventIds && record.eventIds.length>0&&<div class="record-events">{record.eventIds.map(id=><a href={`/events/${id}/`}>{eventById(id).title} ↗</a>)}</div>}</td>
          </tr>)}</tbody>
        </table></Fragment>):<p class="evidence-note">{section.note}</p>}
      </section>)}
      {d.scholarship && d.scholarship.length>0&&<section id="scholarship" class="article-section">
        <div class="section-eyebrow">从功业走向个人</div><h2>治学、文学与个人侧面</h2>
        {d.scholarship.map(item=><div class="narrative-part"><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p></div>)}
      </section>}
      {d.assessment && d.assessment.length>0&&<section id="assessment" class="article-section">
        <div class="section-eyebrow">回看史家的判断</div><h2>史家评价</h2>
        {d.assessment.map(item=><div class="narrative-part"><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p></div>)}
      </section>}
      <section id="relations" class="article-section">
        <div class="section-eyebrow">他与谁的故事交织</div><h2>人物关系</h2>
        {d.contextRelations ? <div class="context-relations">{d.contextRelations.map(item=><div class="narrative-part"><span class="section-eyebrow">{item.category}</span><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p><div class="record-events">{item.people.map(r=><a href={`/people/${r.personId}/`}>{r.name} ↗</a>)}</div></div>)}</div> : <div class="relation-list">
          {p.relations.map(r=><div class="relation"><a href={`/people/${r.personId}/`}>{personById(r.personId).name}<span aria-hidden="true">↗</span></a><p>{r.label}<Citations refs={r.refs} all={refs}/></p></div>)}
          {d.extraRelations.map(r=><div class="relation"><span class="relation-name">{r.name}</span><p>{r.label}<Citations refs={r.refs} all={refs}/></p>{r.people&&r.people.length>0&&<div class="record-events">{r.people.map(who=><a href={`/people/${who.personId}/`}>{who.name} ↗</a>)}</div>}</div>)}
        </div>}
      </section>
      {!d.expanded&&p.note&&<aside id="reading-note" class="editor-note"><span class="section-eyebrow">阅读提示</span><h3>{p.note.title}</h3><p>{p.note.text}<Citations refs={p.note.refs} all={refs}/></p></aside>}
      {d.readingNotes && d.readingNotes.length>0&&<section id="reading-note" class="article-section reading-notes"><div class="section-eyebrow">正文、引书、评论与异说</div><h2>阅读提示与史料辨析</h2>{d.readingNotes.map(item=><details class="reading-item"><summary>{item.title}</summary><p>{item.text}<Citations refs={item.refs} all={refs}/></p></details>)}</section>}
      {d.factDetails&&<details class="fact-details"><summary>档案详解与依据</summary><dl>{d.factDetails.map(item=><><dt>{item.label}</dt><dd>{item.text}<Citations refs={item.refs} all={refs}/></dd></>)}</dl></details>}
      {d.glossary.length>0&&<details class="glossary"><summary>文中名词 <span>{d.glossary.map(item=>item.term).join(' · ')}</span></summary><dl>{d.glossary.map(item=><><dt>{item.term}</dt><dd>{item.text}</dd></>)}</dl></details>}
      <section id="related-events" class="article-section">
        <div class="section-eyebrow">从人物走向事件</div><h2>相关事件</h2>
        <div class="event-list compact">{p.eventIds.map(id=>{const note=d.relatedEventNotes?.find(n=>n.eventId===id); return note?<a class="event-reading-note" href={`/events/${id}/`}><small>{eventById(id).time}</small><h3>{note.label} ↗</h3><p>{note.text}</p></a>:<EventRow event={eventById(id)}/>;})}</div>
      </section>
      <Sources refs={refs} expanded={d.expanded} scope={d.sourceScope}/>
      <section class="original-invite"><span>继续读他的原传</span>{p.reading.map(id=>{const v=volumes.find(x=>x.id===id)!;return <a href={`/read/${id}/`}>{volumeTitle(v)} ↗</a>;})}</section>
    </article>
  </div>
</div>

<style>
  .event-reading-note{display:block;padding:20px 0;border-bottom:1px solid var(--line)}
  .event-reading-note small{font-size:11px;color:var(--muted)}
  .event-reading-note h3{font:19px/1.7 var(--serif);margin:6px 0}
  .event-reading-note p{font-size:13px;margin:0;color:var(--muted)}
  .narrative-part h3,.group-title{font:20px/1.6 var(--serif);margin:25px 0 10px}
  .narrative-part{margin-bottom:24px}
  .group-title{padding:13px 0;border-top:1px solid var(--line);color:var(--red);font-size:18px;margin-top:32px}
  .expanded-dossier .source-scope{font-size:12px;line-height:1.95;margin-bottom:28px}
  .reading-item{border-bottom:1px solid var(--line);padding:16px 0}
  .reading-item summary{cursor:pointer;line-height:1.85;font-family:var(--serif);font-size:17px}
  .reading-item p{margin:15px 0 4px}
  .context-relations .narrative-part{padding-bottom:18px;border-bottom:1px solid var(--line)}
  .context-relations h3{margin-top:7px}
  .fact-details dl{grid-template-columns:70px minmax(0,1fr)}
  .reading-tier{display:inline-block;margin-left:14px;padding:3px 9px;border:1px solid var(--line);color:var(--red);font-size:10px;letter-spacing:1px}
  .profile-evidence{font-size:10px;color:var(--muted);margin:12px 0 20px;line-height:1.9}
  .lifespan-evidence{margin-top:5px;font-size:10px;color:var(--muted)}
  .lifespan-evidence summary{cursor:pointer;width:fit-content}
  .lifespan-evidence p{margin-top:6px;line-height:1.9}
  .lifespan-evidence a{display:block;color:var(--red)}
  .dossier-table{width:100%;border-collapse:collapse;table-layout:fixed;border-top:1px solid var(--line);font-size:12px;line-height:1.95}
  .dossier-table th,.dossier-table td{text-align:left;vertical-align:top;padding:17px 12px;border-bottom:1px solid var(--line);overflow-wrap:anywhere}
  .dossier-table thead th{font-size:11px;color:var(--muted);font-weight:400;background:rgba(120,90,55,.035)}
  .dossier-table tbody th{font-weight:400;color:var(--muted);font-size:11px}
  .dossier-table p{margin:0}
  .dossier-table strong{font-weight:600}
  .career-table th:first-child{width:22%}
  .career-table thead th:nth-child(2){width:43%}
  .career-table .milestone-date{font-size:11px;color:inherit}
  .office-change{color:var(--red)}
  .no-change{color:var(--muted)}
  .achievement-table th:first-child{width:16%}
  .achievement-table thead th:nth-child(2){width:23%}
  .achievement-table thead th:nth-child(3){width:15%}
  .record-category{font-size:11px;color:var(--muted)}
  .record-events{display:flex;flex-wrap:wrap;gap:3px 12px;margin-top:7px}
  .record-events a{font-size:10px;color:var(--red);text-decoration:underline;text-underline-offset:3px}
  .phase-row th{padding:26px 0 10px!important;border-bottom:1px solid var(--red)!important;background:none!important;color:var(--ink,inherit)!important;font-size:12px!important}
  .phase-row strong{font:18px var(--serif);color:var(--red);margin:0 12px 0 8px}
  .phase-no{display:inline-block;width:22px;height:22px;border:1px solid var(--red);border-radius:50%;color:var(--red);font-size:11px;line-height:20px;text-align:center}
  .phase-when{color:var(--muted);font-size:11px;margin-right:12px}
  .phase-row a{font-size:11px;color:var(--red);text-decoration:underline;text-underline-offset:3px;white-space:nowrap}
  .phase-unmapped{font-size:11px;color:var(--muted)}
  .trajectory .evidence-note{font-size:12px;line-height:1.95;margin-bottom:20px}
  .trajectory .evidence-note a{color:var(--red)}
  .atlas-frame{position:relative;width:100%;height:min(78vh,760px);min-height:520px;border:1px solid var(--line);background:rgba(120,90,55,.035)}
  .atlas-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .atlas-open{display:inline-block;margin:12px 0 26px;font-size:12px;color:var(--red)}
  .trajectory-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line);font-size:12px;line-height:1.9}
  .trajectory-list li{display:grid;grid-template-columns:30px minmax(0,1fr);gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}
  .stop-index{width:22px;height:22px;border:1px solid var(--red);border-radius:50%;color:var(--red);font-size:11px;line-height:20px;text-align:center}
  .trajectory-list strong{font:16px var(--serif);color:var(--red)}
  .trajectory-list .phase-meta{margin-left:10px;font-size:11px;color:var(--muted)}
  .trajectory-list p{margin:3px 0 0;color:var(--muted)}
  .stop-row{display:inline-block;margin-right:14px;color:var(--muted)}
  .stop-row:hover{color:var(--red)}
  .career-table tr{scroll-margin-top:30px}
  .evidence-note{padding:18px 22px;border-left:2px solid var(--line);background:rgba(120,90,55,.035);color:var(--muted)}
  .relation-name{font:19px var(--serif)}
  :is(.glossary,.fact-details){margin:0 0 42px;border-block:1px solid var(--line);padding:16px 0;font-size:12px;scroll-margin-top:30px}
  :is(.glossary,.fact-details) summary{cursor:pointer;list-style-position:inside}
  :is(.glossary,.fact-details) summary span{margin-left:14px;color:var(--muted);font-size:11px}
  :is(.glossary,.fact-details) dl{display:grid;grid-template-columns:55px 1fr;gap:10px 20px;margin:20px 0 5px}
  :is(.glossary,.fact-details) dd{margin:0;color:var(--muted);line-height:1.9}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:640px){
    .dossier-table,.dossier-table tbody{display:block}
    .dossier-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
    .dossier-table tr{display:block;padding:17px 0;border-bottom:1px solid var(--line)}
    .dossier-table th,.dossier-table td{display:block;width:auto!important;border:0;padding:4px 0;font-size:13px;line-height:1.95}
    .dossier-table tbody th{padding-top:0;color:var(--red);font-size:11px}
    .career-table .milestone-date{font-size:11px}
    .dossier-table td::before{content:attr(data-label);display:block;font-size:10px;color:var(--muted);letter-spacing:1px;margin-top:5px}
    .dossier-table .no-change{display:none}
    .achievement-table td:nth-child(2)::before,.achievement-table td:nth-child(3)::before{display:none}
    .achievement-table td:nth-child(2){font-size:16px;padding-bottom:0}
    .achievement-table td:nth-child(3){padding-top:0}
    .record-events a{font-size:11px}
    .dossier-table tr.phase-row{padding:22px 0 8px;border-bottom:1px solid var(--red)}
    .phase-row th{padding:0!important}
    .phase-row strong{display:inline-block;margin:0 8px}
    .atlas-frame{height:80vh;min-height:560px}
    .record-category{font-size:11px}
    .evidence-note{padding:15px 17px}
    .relation-name{font-size:17px}
    :is(.glossary,.fact-details){margin-bottom:30px}
  }
</style>
