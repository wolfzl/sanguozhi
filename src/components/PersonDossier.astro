---
import Sources from './Sources.astro';
import Citations from './Citations.astro';
import Share from './Share.astro';
import EventRow from './EventRow.astro';
import PersonNarrative from './PersonNarrative.astro';
import FoldGroup from './FoldGroup.astro';
import RelatedEvent from './RelatedEvent.astro';
import { personById, eventById, events, referencesFor, volumes, volumeTitle } from '../lib/catalog';
import { DEFAULT_ATLAS_BASE, versionedAtlasBase, phaseUrl, routeUrl, phaseNumeral } from '../lib/atlas.mjs';
import type { Person, DossierRecord, TrajectoryPhase } from '../lib/catalog';
import { refKey } from '../lib/catalog';
interface Props { person: Person }
const { person: p } = Astro.props;
const d = p.dossier!;
const refs = referencesFor(p);
const sections = [
  {id:'civil-achievements',title:'文治功绩',eyebrow:'治理与谋划',records:d.civil,note:d.civilNote},
  {id:'military-achievements',title:'武功功绩',eyebrow:'征战中的贡献',records:d.military,note:d.militaryNote},
  {id:'setbacks',title:d.expanded?'失误、挫折与争议':'失误与挫折',eyebrow:'看见经历中的得失',records:d.setbacks,note:d.setbacksNote},
];
// Static rendering stamps all map links on this page with the same release token.
// A cached iframe HTML otherwise keeps loading its old hashed JS/data bundles.
const atlasBase = versionedAtlasBase(
  import.meta.env.PUBLIC_ATLAS_BASE || DEFAULT_ATLAS_BASE,
  import.meta.env.PUBLIC_ATLAS_REVISION || Date.now().toString(36),
);
const trajectory = d.trajectory;
const phases = trajectory?.phases ?? [];
const hasTrajectory = phases.length > 0;
const hasUnmappedPhases = phases.some(ph => ph.unmappedReason);
const phaseStart = new Map(phases.map((ph,i)=>[ph.careers[0],{ph,i}]));
const careerTitle = new Map(p.milestones.map(m=>[m.id,m]));
const stopLabel = (ph: {atlasStops?: number[]}) => ph.atlasStops?.length ? `地图第 ${ph.atlasStops.map(n=>n+1).join('、')} 站` : '地图未单列此期';
const recordGroups = (rows: DossierRecord[]) => Array.from(new Set(rows.map(r=>r.group ?? ''))).map(title=>({title,rows:rows.filter(r=>(r.group ?? '')===title)}));
// ---- 大表格分组（折叠）----
interface Group<T> { title: string; when: string; rows: T[]; ph?: TrajectoryPhase; phIndex?: number }
const CHUNK = 5;
const MIN_GROUP = 3;
const yearsIn = (text: string) => (text.match(/\d{3}/g) ?? []).map(Number);
const spanLabel = (whens: string[]) => {
  const ys = whens.flatMap(yearsIn);
  if (!ys.length) return whens[0]?.split(/[，,]/)[0] ?? '';
  const a = Math.min(...ys), b = Math.max(...ys);
  return a === b ? `${a}年` : `${a}—${b}年`;
};
function chunked<T extends {when: string}>(rows: T[]): Group<T>[] {
  const size = Math.ceil(rows.length / Math.ceil(rows.length / CHUNK));
  const out: Group<T>[] = [];
  for (let i = 0; i < rows.length; i += size) {
    const part = rows.slice(i, i + size);
    out.push({title:`第 ${out.length+1} 段`, when:spanLabel(part.map(r=>r.when)), rows:part});
  }
  return out;
}
const phaseIndexFor = (when: string) => {
  const y = yearsIn(when)[0];
  if (y === undefined) return -1;
  let idx = phases.findIndex(ph => y >= ph.span[0] && y <= ph.span[1]);
  if (idx < 0) { phases.forEach((ph,i)=>{ if (ph.span[0] <= y) idx = i; }); if (idx < 0) idx = 0; }
  return idx;
};
// 生平履历：有行迹时期的人按时期分组，否则每 5 条左右一组（不足 7 条不折叠）。
const careerGroups: Group<typeof p.milestones[number]>[] = (() => {
  if (hasTrajectory) {
    const out: Group<typeof p.milestones[number]>[] = [];
    for (const m of p.milestones) {
      const start = m.id ? phaseStart.get(m.id) : undefined;
      if (start || !out.length) out.push({title:start?.ph.title ?? '', when:start?.ph.when ?? '', rows:[], ph:start?.ph, phIndex:start?.i});
      out.at(-1)!.rows.push(m);
    }
    return out;
  }
  return p.milestones.length > CHUNK + 1 ? chunked(p.milestones) : [{title:'', when:'', rows:p.milestones}];
})();
// 功绩/挫折：优先用数据里的分组名；其次按行迹时期归并；否则按条数分段。
function groupRecords(rows: DossierRecord[]): Group<DossierRecord>[] {
  if (rows.some(r=>r.group)) return recordGroups(rows).map(g=>({title:g.title, when:spanLabel(g.rows.map(r=>r.when)), rows:g.rows}));
  if (rows.length <= CHUNK + 1) return [{title:'', when:'', rows}];
  if (hasTrajectory) {
    const by = new Map<number, DossierRecord[]>(); let last = 0;
    for (const r of rows) { let i = phaseIndexFor(r.when); if (i < 0) i = last; last = i; if (!by.has(i)) by.set(i, []); by.get(i)!.push(r); }
    // 相邻时期的条目太少（1—2 条）时并成一组，避免出现一排只有一条的折叠项。
    const merged: {from: number; to: number; rows: DossierRecord[]}[] = [];
    for (const [i, rs] of [...by.entries()].sort((x,y)=>x[0]-y[0])) {
      const last = merged.at(-1);
      if (last && last.rows.length < MIN_GROUP) { last.to = i; last.rows.push(...rs); }
      else merged.push({from:i, to:i, rows:[...rs]});
    }
    if (merged.length > 1 && merged.at(-1)!.rows.length < MIN_GROUP) { const tail = merged.pop()!; const prev = merged.at(-1)!; prev.to = tail.to; prev.rows.push(...tail.rows); }
    if (merged.length > 1) return merged.map(g=>({title:g.from===g.to?phases[g.from].title:`${phases[g.from].title}至${phases[g.to].title}`, when:spanLabel(g.rows.map(r=>r.when))||phases[g.from].when, rows:g.rows, ph:phases[g.from], phIndex:g.from}));
    return [{title:'', when:'', rows}];
  }
  return chunked(rows);
}
const relationGroups = d.contextRelations
  ? Array.from(new Set(d.contextRelations.map(item=>item.category))).map(category=>({category,rows:d.contextRelations!.filter(item=>item.category===category)}))
  : [];
const EVENT_SHOWN = 6;
const relatedIds=[...p.eventIds].sort((a,b)=>events.findIndex(x=>x.id===a)-events.findIndex(x=>x.id===b));
const eventNote = (id: string) => d.relatedEventNotes?.find(n=>n.eventId===id);
const evidenceCount = new Set(d.refs.map(refKey)).size;
const navigation = [
  ['life','人物介绍'],['milestones','生平履历'],...(hasTrajectory ? [['trajectory','行迹地图']] : []),
  ...sections.map(s=>[s.id,s.title]),...(d.scholarship?.length ? [['scholarship','治学与个人侧面']] : []),...(d.assessment?.length ? [['assessment','史家评价']] : []),['relations','人物关系'],...((d.expanded?d.readingNotes?.length:p.note)?[['reading-note',d.expanded?'阅读提示与史料辨析':'阅读提示']]:[]),
  ['related-events','相关事件'],['sources','原文依据'],
];
---
<div id="page-top" class:list={["shell detail-page person-dossier", {"expanded-dossier":d.expanded}]}>
  <a class="back-link" href="/people/">← 人物列表</a>
  <header class="detail-heading">
    <div>
      <div class="eyebrow">人物 / {p.faction}<span class="reading-tier">{d.tier}</span></div>
      <h1>{p.name}<span>{p.courtesy==='本书未详'?'字号未详':`字 ${p.courtesy}`}</span></h1>
      <p class="detail-lead">{p.lead}</p>
    </div>
    <Share />
  </header>
  <nav class="dossier-jump" aria-label="章节跳转" data-dossier-jump>
    {navigation.map(([id,title])=><a href={`#${id}`} data-spy={id}>{title}</a>)}
  </nav>
  <div class="article-layout">
    <aside class="detail-sidebar">
      <div class="profile-seal" aria-hidden="true">{p.name.slice(0,1)}</div>
      <details class="profile-facts" open data-profile-facts>
      <summary class="section-eyebrow">人物小档案<span class="facts-hint"> · 籍贯、官职、爵位</span></summary>
      <dl>
        {p.lifespan && <>
          <dt>生卒年</dt>
          <dd>{p.lifespan.text}<details class="lifespan-evidence"><summary>年代依据</summary><p>{p.lifespan.note}<a href={p.lifespan.sourceUrl}>{p.lifespan.sourceTitle} ↗</a></p></details></dd>
        </>}
        <dt>籍贯</dt><dd>{d.hometown}</dd>
        <dt>主要身份</dt><dd>{p.role}</dd>
        <dt>最高官职</dt><dd>{d.highestOffice}</dd>
        <dt>最高爵位</dt><dd>{d.highestTitle}</dd>
        <dt>谥号</dt><dd>{d.posthumous}</dd>
        <dt>常见称谓</dt><dd>{p.aliases.map(a=>p.id==='zhangfei'&&a==='桓侯'?'张桓侯':a).join('、')||'暂无其他称谓'}</dd>
        <dt>代表事迹</dt><dd>{d.deeds.join('、')}</dd>
      </dl>
      <details class="profile-evidence"><summary>依据 {evidenceCount} 条</summary><Citations refs={d.refs} all={refs}/></details>
      </details>
      <nav aria-label="本页目录" data-dossier-toc>
        {navigation.map(([id,title],index)=><a href={`#${id}`} data-spy={id}>{title}<span>{String(index+1).padStart(2,'0')}</span></a>)}
      </nav>
    </aside>
    <article class="article-body">
      <section id="life" class="article-section">
        <div class="section-eyebrow">认识这个人</div><h2>人物介绍</h2>
        {d.sourceScope && <p class="evidence-note source-scope">{d.sourceScope}</p>}
        {p.paragraphs.map(paragraph=><div class="narrative-part">{paragraph.title&&<h3>{paragraph.title}</h3>}<p><PersonNarrative paragraph={paragraph}/><Citations refs={paragraph.refs} all={refs}/></p></div>)}
      </section>
      <section id="milestones" class="article-section">
        <div class="section-eyebrow">沿着经历看变化</div><h2>生平履历</h2>
        {careerGroups.map((g,gi)=><FoldGroup plain={careerGroups.length===1} id={g.ph?`phase-${g.ph.id}`:undefined} no={g.phIndex!==undefined?phaseNumeral(g.phIndex):String(gi+1)} title={g.title} when={g.when} count={g.rows.length} open={gi===0} mapUrl={g.ph&&phaseUrl(atlasBase,trajectory!,g.ph)||undefined} mapNote={g.ph&&!phaseUrl(atlasBase,trajectory!,g.ph)?(trajectory!.atlasPerson?'本期地图未标点':'本期地点未详'):undefined}>
        <table class="dossier-table career-table">
          <caption class="sr-only">{p.name}的重要经历与官职、爵位变化{g.title&&careerGroups.length>1?`：${g.title}`:''}</caption>
          <thead><tr><th scope="col">时间</th><th scope="col">重要经历</th><th scope="col">官职、爵位变化</th></tr></thead>
          <tbody>{g.rows.map(m=><tr id={m.id?`career-${m.id}`:undefined}>
            <th scope="row" data-label="时间"><span class="milestone-date">{m.when}</span></th>
            <td data-label="重要经历">{d.expanded&&<strong>{m.title}</strong>}<p>{m.text}<Citations refs={m.refs} all={refs}/></p>{m.eventIds && m.eventIds.length>0&&<div class="record-events">{m.eventIds.map(id=><a href={`/events/${id}/`}>{eventById(id).title} ↗</a>)}</div>}</td>
            <td data-label="官职、爵位变化" class:list={{'office-change':m.office!=='—','no-change':m.office==='—'}}>{m.office}</td>
          </tr>)}</tbody>
        </table>
        </FoldGroup>)}
      </section>
      {hasTrajectory&&<section id="trajectory" class="article-section trajectory">
        <div class="section-eyebrow">把经历放回地图</div><h2>行迹地图</h2>
        <p class="evidence-note">{p.name}一生分为 {phases.length} 个时期。{trajectory!.atlasPerson?<Fragment>地图直接使用<a href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">江山时序</a>的{p.name}路线，与在江山时序中搜索{p.name}看到的相同；地图上的说明文字出自江山时序，本站内容以下表和生平履历为准。</Fragment>:<Fragment>{hasUnmappedPhases?"地图标示本书明确记载的地点，地点未详的时期见下表。地图由":"每个时期取一个代表地点，由"}<a href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">江山时序</a>{hasUnmappedPhases?"提供；":"连成路线；"}站名用的是它的地名。</Fragment>}疆域为示意性近似。连线表示已知地点的先后关系，不是古代道路复原；选中时期的到达路段为实线，其余为虚线，虚实不表示史料可信度。未载地点、未实施的计划与身后追谥不补造足迹。</p>
        <div class="atlas-frame"><iframe src={routeUrl(atlasBase,trajectory!,{embed:true})} title={`${p.name}行迹地图`} loading="lazy"></iframe></div>
        <a class="atlas-open" href={routeUrl(atlasBase,trajectory!)} target="_blank" rel="noopener">在江山时序中打开 ↗</a>
        <ol class="trajectory-list">{phases.map((ph,i)=><li>
          <span class="stop-index">{phaseNumeral(i)}</span>
          <div>{phaseUrl(atlasBase,trajectory!,ph)?<a href={phaseUrl(atlasBase,trajectory!,ph)} target="_blank" rel="noopener"><strong>{ph.title}</strong><small class="phase-meta">{ph.when} · {trajectory!.atlasPerson?stopLabel(ph):`${ph.place!.name}${ph.place!.approx?'（地图近似）':''}`} ↗</small></a>:<Fragment><strong>{ph.title}</strong><small class="phase-meta">{ph.when} · {trajectory!.atlasPerson ? "本期未标点" : "地点未详"}</small></Fragment>}
          {ph.unmappedReason&&<p>{ph.unmappedReason}</p>}
          <p>{ph.careers.map(id=>careerTitle.get(id)).map(row=>row&&<a class="stop-row" href={`#career-${row.id}`}>{row.title}</a>)}</p></div>
        </li>)}</ol>
      </section>}
      {sections.map(section=><section id={section.id} class="article-section">
        <div class="section-eyebrow">{section.eyebrow}</div><h2>{section.title}</h2>
        {section.records.length>0?(()=>{const groups=groupRecords(section.records);return groups.map((group,gi)=><FoldGroup plain={groups.length===1} id={group.ph?`${section.id}-${group.ph.id}`:undefined} no={group.phIndex!==undefined?phaseNumeral(group.phIndex):String(gi+1)} title={group.title} when={group.when} count={group.rows.length} open={gi===0}><table class="dossier-table achievement-table">
          <caption class="sr-only">{p.name}的{section.title}{group.title&&groups.length>1?`：${group.title}`:''}</caption>
          <thead><tr><th scope="col">年份</th><th scope="col">{section.id==='setbacks'?'事件':'功绩'}</th><th scope="col">{section.id==='setbacks'?'性质':'类型'}</th><th scope="col">{section.id==='setbacks'?'经过与后果':'具体表现与影响'}</th></tr></thead>
          <tbody>{group.rows.map(record=><tr>
            <th scope="row" data-label="年份">{record.when}</th>
            <td data-label={section.id==='setbacks'?'事件':'功绩'}><strong>{record.title}</strong></td>
            <td data-label={section.id==='setbacks'?'性质':'类型'}><span class="record-category">{record.category}</span></td>
            <td data-label={section.id==='setbacks'?'经过与后果':'具体表现与影响'}><p>{record.text}<Citations refs={record.refs} all={refs}/></p>{record.eventIds && record.eventIds.length>0&&<div class="record-events">{record.eventIds.map(id=><a href={`/events/${id}/`}>{eventById(id).title} ↗</a>)}</div>}</td>
          </tr>)}</tbody>
        </table></FoldGroup>);})():<p class="evidence-note">{section.note}</p>}
      </section>)}
      {d.scholarship && d.scholarship.length>0&&<section id="scholarship" class="article-section">
        <div class="section-eyebrow">从功业走向个人</div><h2>治学、文学与个人侧面</h2>
        {d.scholarship.map(item=><div class="narrative-part"><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p></div>)}
      </section>}
      {d.assessment && d.assessment.length>0&&<section id="assessment" class="article-section">
        <div class="section-eyebrow">回看史家的判断</div><h2>史家评价</h2>
        {d.assessment.map(item=><div class="narrative-part"><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p></div>)}
      </section>}
      <section id="relations" class="article-section">
        <div class="section-eyebrow">他与谁的故事交织</div><h2>人物关系</h2>
        {d.contextRelations ? <div class="context-relations">{relationGroups.map((group,gi)=><FoldGroup plain={relationGroups.length===1} title={group.category} count={group.rows.length} open={gi===0}>{group.rows.map(item=><div class="narrative-part"><h3>{item.title}</h3><p>{item.text}<Citations refs={item.refs} all={refs}/></p><div class="record-events">{item.people.map(r=><a href={`/people/${r.personId}/`}>{r.name} ↗</a>)}</div></div>)}</FoldGroup>)}</div> : <div class="relation-list">
          {p.relations.map(r=><div class="relation"><a href={`/people/${r.personId}/`}>{personById(r.personId).name}<span aria-hidden="true">↗</span></a><p>{r.label}<Citations refs={r.refs} all={refs}/></p></div>)}
          {d.extraRelations.map(r=><div class="relation"><span class="relation-name">{r.name}</span><p>{r.label}<Citations refs={r.refs} all={refs}/></p>{r.people&&r.people.length>0&&<div class="record-events">{r.people.map(who=><a href={`/people/${who.personId}/`}>{who.name} ↗</a>)}</div>}</div>)}
        </div>}
      </section>
      {!d.expanded&&p.note&&<aside id="reading-note" class="editor-note"><span class="section-eyebrow">阅读提示</span><h3>{p.note.title}</h3><p>{p.note.text}<Citations refs={p.note.refs} all={refs}/></p></aside>}
      {d.readingNotes && d.readingNotes.length>0&&<section id="reading-note" class="article-section reading-notes"><div class="section-eyebrow">正文、引书、评论与异说</div><h2>阅读提示与史料辨析</h2>{d.readingNotes.map(item=><details class="reading-item"><summary>{item.title}</summary><p>{item.text}<Citations refs={item.refs} all={refs}/></p></details>)}</section>}
      {d.factDetails&&<details class="fact-details"><summary>档案详解与依据</summary><dl>{d.factDetails.map(item=><><dt>{item.label}</dt><dd>{item.text}<Citations refs={item.refs} all={refs}/></dd></>)}</dl></details>}
      {d.glossary.length>0&&<details class="glossary"><summary>文中名词 <span>{d.glossary.map(item=>item.term).join(' · ')}</span></summary><dl>{d.glossary.map(item=><><dt>{item.term}</dt><dd>{item.text}</dd></>)}</dl></details>}
      <section id="related-events" class="article-section">
        <div class="section-eyebrow">从人物走向事件</div><h2>相关事件</h2>
        <div class="event-list compact">{relatedIds.slice(0,EVENT_SHOWN).map(id=><RelatedEvent id={id} note={eventNote(id)}/>)}</div>
        {relatedIds.length>EVENT_SHOWN&&<details class="more-events"><summary>更多相关事件（还有 {relatedIds.length-EVENT_SHOWN} 个）<span aria-hidden="true">+</span></summary><div class="event-list compact">{relatedIds.slice(EVENT_SHOWN).map(id=><RelatedEvent id={id} note={eventNote(id)}/>)}</div></details>}
        {p.eventIds.length === 0 && <p class="muted">本站暂无可直接关联的事件，可继续读下方的原传。</p>}
      </section>
      <Sources refs={refs} expanded={d.expanded} scope={d.sourceScope}/>
      <section class="original-invite"><span>继续读他的原传</span>{p.reading.map(id=>{const v=volumes.find(x=>x.id===id)!;return <a href={`/read/${id}/`}>{volumeTitle(v)} ↗</a>;})}</section>
    </article>
  </div>
  <a class="to-top" href="#page-top" data-to-top aria-label="回到顶部"><span aria-hidden="true">↑</span><small>顶部</small></a>
</div>
<script>import '../lib/dossier-ui';</script>

<style>

  /* ---- 减负：折叠、吸顶目录、回到顶部 ---- */
  .profile-facts > summary{cursor:default;list-style:none;display:block}
  .profile-facts > summary::-webkit-details-marker{display:none}
  .facts-hint{display:none}
  .profile-evidence{margin:12px 0 20px}
  .profile-evidence > summary{cursor:pointer;width:fit-content;color:var(--red);font-size:11px;letter-spacing:1px;list-style:none}
  .profile-evidence > summary::-webkit-details-marker{display:none}
  .profile-evidence > summary::before{content:"+";display:inline-block;width:1.1em;color:var(--muted)}
  .profile-evidence[open] > summary::before{content:"−"}
  .profile-evidence .citations{display:block;margin:8px 0 0;line-height:2.2}
  .dossier-jump{display:none}
  .detail-sidebar nav > a[aria-current="location"]{color:var(--red)}
  .detail-sidebar nav > a[aria-current="location"] > span{color:var(--red)}
  .to-top{position:fixed;right:22px;bottom:22px;z-index:40;width:46px;height:46px;border-radius:50%;background:var(--ink);color:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;line-height:1;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .2s,transform .2s,visibility .2s;box-shadow:0 8px 20px -10px rgba(39,44,41,.55)}
  .to-top span{font-size:15px}
  .to-top small{font-size:8px;letter-spacing:1px;margin-top:2px}
  .to-top:hover{background:var(--red);color:var(--paper)}
  .to-top.is-visible{opacity:1;visibility:visible;transform:none}
  @media(min-width:801px){
    .detail-sidebar{position:static;align-self:stretch}
    .detail-sidebar nav{position:sticky;top:18px;max-height:calc(100vh - 36px);overflow-y:auto;overscroll-behavior:contain;margin-top:6px}
  }
  @media(max-width:800px){
    .dossier-jump{display:flex;position:sticky;top:0;z-index:30;gap:8px;overflow-x:auto;padding:10px 0;margin-top:2px;background:var(--paper);border-bottom:1px solid var(--line);scrollbar-width:none;-webkit-overflow-scrolling:touch}
