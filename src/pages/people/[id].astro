---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import Citations from '../../components/Citations.astro';
import Share from '../../components/Share.astro';
import EventRow from '../../components/EventRow.astro';
import {people,personById,eventById,referencesFor,volumes,volumeTitle} from '../../lib/catalog';
import type {Person} from '../../lib/catalog';
export function getStaticPaths(){return people.map(person=>({params:{id:person.id},props:{person}}));}
interface Props {person: Person}
const {person:p}=Astro.props;const refs=referencesFor(p);
---
<Base title={p.courtesy==='本书未详'?p.name:`${p.name} · 字${p.courtesy}`} description={p.lead} active="people"><div class="shell detail-page"><a class="back-link" href="/people/">← 人物列表</a><header class="detail-heading"><div><div class="eyebrow">人物 / {p.faction}</div><h1>{p.name}<span>{p.courtesy==='本书未详'?'字号未详':`字 ${p.courtesy}`}</span></h1><p class="detail-lead">{p.lead}</p></div><Share/></header><div class="article-layout"><aside class="detail-sidebar"><div class="profile-seal" aria-hidden="true">{p.name.slice(0,1)}</div><span class="section-eyebrow">人物小档案</span><dl><dt>主要身份</dt><dd>{p.role}</dd><dt>所处时期</dt><dd>{p.period}</dd><dt>常见称谓 / 检索词</dt><dd>{p.aliases.join('、')}</dd></dl><nav aria-label="本页目录"><a href="#life">人物生平 <span>01</span></a><a href="#milestones">关键经历 <span>02</span></a><a href="#relations">人物关系 <span>03</span></a><a href="#related-events">相关事件 <span>04</span></a><a href="#sources">原文依据 <span>05</span></a></nav></aside><article class="article-body"><section id="life" class="article-section"><div class="section-eyebrow">认识这个人</div><h2>{p.role}</h2>{p.paragraphs.map(paragraph=><p>{paragraph.text}<Citations refs={paragraph.refs} all={refs}/></p>)}</section>
<section id="milestones" class="article-section"><div class="section-eyebrow">沿着经历看变化</div><h2>关键经历</h2><ol class="milestone-list">{p.milestones.map(m=><li><span class="milestone-date">{m.when}</span><h3>{m.title}</h3><p>{m.text}<Citations refs={m.refs} all={refs}/></p></li>)}</ol></section>
<section id="relations" class="article-section"><div class="section-eyebrow">他与谁的故事交织</div><h2>人物关系</h2><div class="relation-list">{p.relations.map(r=><div class="relation"><a href={`/people/${r.personId}/`}>{personById(r.personId).name}<span aria-hidden="true">↗</span></a><p>{r.label}<Citations refs={r.refs} all={refs}/></p></div>)}</div></section>
{p.note&&<aside class="editor-note"><span class="section-eyebrow">阅读提示</span><h3>{p.note.title}</h3><p>{p.note.text}<Citations refs={p.note.refs} all={refs}/></p></aside>}
<section id="related-events" class="article-section"><div class="section-eyebrow">从人物走向事件</div><h2>相关事件</h2><div class="event-list compact">{p.eventIds.map(id=><EventRow event={eventById(id)}/>)}</div>{p.eventIds.length===0&&<p>先从人物原传继续探索。</p>}</section><Sources refs={refs}/><section class="original-invite"><span>继续读他的原传</span>{p.reading.map(id=>{const v=volumes.find(x=>x.id===id)!;return <a href={`/read/${id}/`}>{volumeTitle(v)} ↗</a>;})}</section></article></div></div></Base>
