---
import Base from '../../layouts/Base.astro';
import {volumes,volumeTitle} from '../../lib/catalog';
import type {Volume} from '../../lib/catalog';
export function getStaticPaths(){return volumes.map((volume,index)=>({params:{volume:volume.id},props:{volume,index}}));}
interface Props {volume: Volume; index: number}
const {volume:v,index}=Astro.props;const prev=volumes[index-1];const next=volumes[index+1];
---
<Base title={volumeTitle(v)} description={`${v.title}，陈寿正文与裴松之注，支持简繁切换，保留来源与修订信息。`} active="read"><div class="shell reader-page"><a class="back-link" href="/read/">← 全书目录</a><header class="reader-heading"><div class="eyebrow">{v.id==='appendix'?'附录':`原文 / 卷 ${Number(v.id)}`}</div><h1>{volumeTitle(v)}</h1><p>来源：<a href={v.permalink} target="_blank" rel="noopener">维基文库 · 修订 {v.revision} ↗</a></p></header><div class="reader-toolbar"><label><span class="sr-only">切换卷目</span><select data-volume-select>{volumes.map(vol=><option value={vol.id} selected={vol.id===v.id}>{vol.id==='appendix'?'附录':`卷${Number(vol.id)}`} · {volumeTitle(vol)}</option>)}</select></label><div class="reader-script-controls" data-script-controls role="group" aria-label="原文字形" hidden><button type="button" data-reader-script="simplified" aria-pressed="false">简体</button><button type="button" data-reader-script="traditional" aria-pressed="true">繁体</button></div><button type="button" data-notes aria-pressed="true"><span class="toggle-dot" aria-hidden="true"></span><span data-note-state>显示裴注</span></button></div><p class="reader-hint"><span data-reader-script-state aria-live="polite">繁体底本保留，支持简繁切换。</span>灰底缩进为裴注；从卡片进入的引用段落会突出显示。</p><noscript><p class="reader-hint">启用 JavaScript 后可显示简体并切换字形；当前显示繁体底本。</p></noscript><article class="original-text" data-reader lang="zh-Hant">{v.blocks.map(b=><Fragment set:html={b.html}/>)}</article><nav class="reader-pagination" aria-label="卷目翻页">{prev?<a href={`/read/${prev.id}/`}><span>← 上一卷</span><strong>{volumeTitle(prev)}</strong></a>:<span/>}{next?<a href={`/read/${next.id}/`}><span>下一卷 →</span><strong>{volumeTitle(next)}</strong></a>:<a href="/read/">返回全书目录 →</a>}</nav></div></Base>
<script>import '../../lib/reader-script';</script>
