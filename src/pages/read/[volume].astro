---
import Base from '../../layouts/Base.astro';
import {volumes,volumeTitle} from '../../lib/catalog';
import type {Volume} from '../../lib/catalog';
import BaihuaText from '../../components/BaihuaText.astro';
import {linkPeopleInHtml} from '../../lib/person-links';
import type wudiTranslation from '../../data/translations/001.json';
const translations = Object.values(import.meta.glob<typeof wudiTranslation>('../../data/translations/*.json', {eager:true, import:'default'}));
export function getStaticPaths(){return volumes.map((volume,index)=>({params:{volume:volume.id},props:{volume,index}}));}
interface Props {volume: Volume; index: number}
const {volume:v,index}=Astro.props;const prev=volumes[index-1];const next=volumes[index+1];
const translation = translations.find(item => item.volumeId === v.id);
const sectionTitles = new Map(translation?.sections.map(section => [section.startsAt, section.title]));
---
<Base title={volumeTitle(v)} description={`${volumeTitle(v)}，陈寿正文与裴松之注，支持简繁${translation?'及白话':''}切换，保留来源与修订信息。`} active="read">
  <div class="shell reader-page">
    <a class="back-link" href="/read/">← 全书目录</a>
    <header class="reader-heading">
      <div class="eyebrow">{v.id==='appendix'?'附录':<><span data-reader-type>原文</span> / 卷 {Number(v.id)}</>}</div>
      <h1>{volumeTitle(v)}</h1>
      <p>来源：<a href={v.permalink} target="_blank" rel="noopener">维基文库 · 修订 {v.revision} ↗</a></p>
    </header>
    <div class="reader-toolbar">
      <label><span class="sr-only">切换卷目</span><select data-volume-select>{volumes.map(vol=><option value={vol.id} selected={vol.id===v.id}>{vol.id==='appendix'?'附录':`卷${Number(vol.id)}`} · {volumeTitle(vol)}</option>)}</select></label>
      <div class="reader-script-controls" data-script-controls role="group" aria-label="阅读版本" hidden>
        <button type="button" data-reader-script="simplified" aria-pressed="false">简体</button>
        <button type="button" data-reader-script="traditional" aria-pressed="true">繁体</button>
        {translation && <button type="button" data-reader-script="baihua" aria-pressed="false">白话</button>}
      </div>
      <button type="button" data-notes aria-pressed="true"><span class="toggle-dot" aria-hidden="true"></span><span data-note-state>显示裴注</span></button>
      {translation && <button type="button" data-parallel aria-pressed="false" hidden><span class="toggle-dot" aria-hidden="true"></span><span>逐段对照</span></button>}
    </div>
    <p class="reader-hint"><span data-reader-script-state aria-live="polite">繁体底本保留，支持简繁切换。</span>灰底缩进为裴注；从卡片进入的引用段落会突出显示。文中带下划线的人名可进入人物页。</p>
    <noscript><p class="reader-hint">启用 JavaScript 后可切换阅读版本；当前显示繁体底本。</p></noscript>
    {translation && <div class="baihua-banner" data-baihua-banner role="note" hidden><strong>AI 辅助白话试译，仅供参考，以原文为准。</strong><span>逐段译自本站原文，尚未经人工审校。可开启上方「逐段对照」，在每段白话下核对简体原文。</span></div>}
    <article class="original-text" data-reader lang="zh-Hant">{v.blocks.map(b=><Fragment set:html={linkPeopleInHtml(b.html,b.tag,b.kind)}/>)}</article>
    {translation && <template data-baihua>
      {translation.blocks.map(block => <>
        {sectionTitles.has(block.id) && <h2>{sectionTitles.get(block.id)}</h2>}
        <div id={block.id} class="baihua-block">
          {block.translation && <div data-baihua-main><BaihuaText text={block.translation} seen={new Set<string>()}/></div>}
          {block.notes.filter(note => note.translation.trim()).map(note => <aside id={note.id} class="peizhu"><strong class="baihua-note-label">裴注白话</strong><div data-baihua-note><BaihuaText text={note.translation}/></div></aside>)}
        </div>
      </>)}
    </template>}
    <nav class="reader-pagination" aria-label="卷目翻页">{prev?<a href={`/read/${prev.id}/`}><span>← 上一卷</span><strong>{volumeTitle(prev)}</strong></a>:<span/>}{next?<a href={`/read/${next.id}/`}><span>下一卷 →</span><strong>{volumeTitle(next)}</strong></a>:<a href="/read/">返回全书目录 →</a>}</nav>
  </div>
</Base>
<script>import '../../lib/reader-script';</script>
