---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import Citations from '../../components/Citations.astro';
import Share from '../../components/Share.astro';
import EventRow from '../../components/EventRow.astro';
import {events,personById,referencesFor} from '../../lib/catalog';
import type {Event} from '../../lib/catalog';
export function getStaticPaths(){return events.map(event=>({params:{id:event.id},props:{event}}));}
interface Props {event: Event}
const {event:e}=Astro.props;const refs=referencesFor(e);const index=events.findIndex(x=>x.id===e.id);
---
<Base title={e.title} description={e.lead} active="events"><div class="shell detail-page"><a class="back-link" href="/events/">← 事件列表</a><header class="detail-heading event-detail-heading"><div><div class="eyebrow">事件 / {e.tags.join(' · ')}</div><h1>{e.title}</h1><p class="event-date">{e.time}</p><p class="detail-lead">{e.lead}</p></div><Share/></header><div class="article-layout"><aside class="detail-sidebar"><div class="year-seal">{e.year}<small>公元 / 事件起始或主要年份</small></div><span class="section-eyebrow">相关人物</span><div class="participant-list">{e.participants.map(p=><div><a href={`/people/${p.personId}/`}>{personById(p.personId).name}<span aria-hidden="true">↗</span></a><p>{p.role}</p></div>)}</div><nav aria-label="本页目录">{e.sections.map((s,i)=><a href={`#part-${i+1}`}>{s.heading}<span>{String(i+1).padStart(2,'0')}</span></a>)}<a href="#sources">原文依据 <span>05</span></a></nav></aside><article class="article-body">{e.sections.map((s,i)=><section class="article-section" id={`part-${i+1}`}><div class="section-eyebrow">{String(i+1).padStart(2,'0')} / {s.interpretation?'阅读解读':'事件脉络'}</div><h2>{s.heading}</h2><p>{s.text}<Citations refs={s.refs} all={refs}/></p></section>)}{e.note&&<aside class="editor-note"><span class="section-eyebrow">史料中的不同侧重</span><h3>{e.note.title}</h3><p>{e.note.text}<Citations refs={e.note.refs} all={refs}/></p></aside>}<Sources refs={refs}/><section class="article-section next-events"><div class="section-eyebrow">沿时间继续读</div><h2>相邻事件</h2>{[events[index-1],events[index+1]].filter(Boolean).map(event=><EventRow event={event}/>)}</section></article></div></div></Base>
