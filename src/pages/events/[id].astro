---
import Base from '../../layouts/Base.astro';
import Sources from '../../components/Sources.astro';
import Citations from '../../components/Citations.astro';
import Share from '../../components/Share.astro';
import EventRow from '../../components/EventRow.astro';
import {events,participantName,referencesFor,relationsForEvent,eventById} from '../../lib/catalog';
import type {Event} from '../../lib/catalog';
import {categories,eventTypeLabel,laneLabel,relationTypes} from '../../lib/timeline.mjs';
import {CAMPAIGNS,campaignUrl,DEFAULT_ATLAS_BASE,versionedAtlasBase} from '../../lib/atlas.mjs';
import '../../styles/timeline.css';
export function getStaticPaths(){return events.map(event=>({params:{id:event.id},props:{event}}));}
interface Props {event: Event}
const {event:e}=Astro.props;const relRank=(r:{type:string,from:string})=>r.type==='parallel'?1:r.from===e.id?2:0;const relations=relationsForEvent(e.id).map(r=>({r,o:eventById(r.from===e.id?r.to:r.from)})).sort((a,b)=>relRank(a.r)-relRank(b.r)||(a.o?.year??0)-(b.o?.year??0)||(a.o?.endYear??0)-(b.o?.endYear??0)).map(x=>x.r);const refs=referencesFor({event:e,relations});const index=events.findIndex(x=>x.id===e.id);
const campaign=CAMPAIGNS[e.id as keyof typeof CAMPAIGNS];
const atlasBase=versionedAtlasBase(import.meta.env.PUBLIC_ATLAS_BASE||DEFAULT_ATLAS_BASE,import.meta.env.PUBLIC_ATLAS_REVISION||Date.now().toString(36));
---
<Base title={e.title} description={e.lead} active="events"><div class="shell detail-page"><a class="back-link" href="/events/" data-timeline-back>← 返回事件线</a><header class="detail-heading event-detail-heading"><div><div class="eyebrow">事件 / {eventTypeLabel(e)}</div><h1>{e.title}</h1><p class="event-date">{e.time}</p><p class="detail-lead">{e.lead}</p><div class="event-context-tags"><span>{e.importance==='key'?'关键事件':'事件节点'}</span>{e.lanes.map(lane=><a href={lane==='common'?'/events/?importance=all':`/events/?importance=all&lane=${lane}`}>{laneLabel(lane,e.year)}</a>)}{e.categories.map(c=><a href={`/events/?importance=all&category=${c}`}>{categories[c]}</a>)}</div></div><Share/></header>{campaign&&<section class="event-campaign" id="campaign"><div class="section-eyebrow">战役推演 · {campaign.phases} 个阶段</div><h2>在地图上看{campaign.title}</h2><p class="event-campaign-note">{campaign.hook}分阶段推演由<a href={campaignUrl(atlasBase,campaign)} target="_blank" rel="noopener">江山时序</a>提供，据《三国志》示意复原，营址与路线为近似位置。点地图中的阶段编号或“自动播放”逐步观看。</p><div class="campaign-frame"><iframe src={campaignUrl(atlasBase,campaign,{embed:true})} title={`${campaign.title}战役推演地图`} loading="lazy"></iframe></div><a class="campaign-open" href={campaignUrl(atlasBase,campaign)} target="_blank" rel="noopener">在江山时序中全屏打开 ↗</a></section>}<div class="article-layout"><aside class="detail-sidebar"><div class="year-seal">{e.year}<small>公元 / 事件起始或主要年份</small></div><span class="section-eyebrow">相关人物</span><div class="participant-list">{e.participants.map(p=><div>{p.personId?<a href={`/people/${p.personId}/`}>{participantName(p)}<span aria-hidden="true">↗</span></a>:<span class="participant-name">{participantName(p)}</span>}<p>{p.role}</p></div>)}</div><nav aria-label="本页目录">{campaign&&<a href="#campaign">战役推演 <span>⚔</span></a>}{e.sections.map((s,i)=><a href={`#part-${i+1}`}>{s.heading}<span>{String(i+1).padStart(2,'0')}</span></a>)}<a href="#event-relations">事件关联 <span>↗</span></a><a href="#sources">原文依据 <span>文</span></a></nav></aside><article class="article-body">{e.sections.map((s,i)=><section class="article-section" id={`part-${i+1}`}><div class="section-eyebrow">{String(i+1).padStart(2,'0')} / {s.interpretation?'阅读解读':'事件脉络'}</div><h2>{s.heading}</h2><p>{s.text}<Citations refs={s.refs} all={refs}/></p></section>)}{e.note&&<aside class="editor-note"><span class="section-eyebrow">史料中的不同侧重</span><h3>{e.note.title}</h3><p>{e.note.text}<Citations refs={e.note.refs} all={refs}/></p></aside>}<section class="article-section event-relations" id="event-relations"><div class="section-eyebrow">理解事件之间的联系</div><h2>事件关联</h2>{relations.map(r=>{
const other=eventById(r.from===e.id?r.to:r.from);
const direction=r.type==='parallel'?'同时代对照':r.type==='context'?(r.from===e.id?'后果与后续':'前因与背景'):(r.from===e.id?'后续节点':'前序节点');
return <div class="event-relation-item"><div class="event-relation-type">{relationTypes[r.type]} · {direction}</div><h3><a href={`/events/${other.id}/`}>{other.title} ↗</a></h3><small>{other.time}{r.interpretation?' · 阅读解读':''}</small><p>{r.summary}<Citations refs={r.refs} all={refs}/></p></div>;
})}</section><Sources refs={refs}/><section class="article-section next-events"><div class="section-eyebrow">沿时间继续读</div><h2>相邻事件</h2>{[events[index-1],events[index+1]].filter(Boolean).map(event=><EventRow event={event}/>)}</section></article></div></div></Base>
